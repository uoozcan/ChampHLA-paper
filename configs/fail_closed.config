/*
 * Fail-closed overrides for confirmation runs.
 *
 * The pipeline default is nextflow.config:103
 *
 *     errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
 *
 * 'ignore' means a caller that fails twice is dropped and the workflow continues
 * to completion. The run then reports success while the panel is short a voter,
 * and downstream steps cannot tell the difference between "this caller abstained"
 * and "this caller was silently removed". A consensus computed over a panel that
 * quietly lost a member is not the method the paper describes.
 *
 * Retries are kept, because genuinely transient conditions exist on a shared
 * cluster: a bad node, a filesystem hiccup, a scheduler timeout. What is removed
 * is the final 'ignore'.
 *
 * Use with:
 *     nextflow run main.nf -profile roihu,singularity \
 *         -params-file conf/roihu_params.yaml \
 *         -c configs/fail_closed.config
 *
 * Note that a non-zero exit is not the only way a caller can fail. SpecHLA exited
 * 0 on 2026-09-16 while writing a header and no calls, so this config must be
 * paired with scripts/validate_caller_outputs.py, which reads the output rather
 * than hashing it.
 */

process {
    // Retry transient failures, then stop. Never continue past a failed caller.
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
    maxRetries    = 2

    // One failed task ends the run rather than letting others race to completion.
    maxErrors     = 1

    // Kourami's wrapper can mask a killed JVM with `|| true`, and it is the
    // heaviest memory consumer in the panel. Give it room and escalate on retry.
    withName: 'KOURAMI.*' {
        cpus   = 8
        memory = { task.attempt == 1 ? 64.GB : 128.GB }
        time   = 8.h
    }

    // POLYSOLVER is fed the whole exome BAM rather than an HLA extract, so its
    // work directory peaks near 35 GB. Measured 2026-09-11.
    withName: 'POLYSOLVER.*' {
        time = 8.h
    }
}

// Record what actually ran, so a short panel is visible after the fact.
trace {
    enabled   = true
    overwrite = true
    fields    = 'task_id,process,tag,status,exit,attempt,realtime,peak_rss,workdir'
}

report  { enabled = true; overwrite = true }
timeline { enabled = true; overwrite = true }
